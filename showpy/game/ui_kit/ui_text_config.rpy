################################################################################
## UI Kit — UI 글 설정 (확인 창 글, 버튼 글자) (3.23)
##
## 종료 확인 창("종료하겠습니까?"), 퀵메뉴 버튼("되감기", "넘기기") 같은 글을
## screens.rpy를 고치지 않고 바꿉니다. 적지 않은 글은 원래대로입니다.
##
## 편집기(개발 모드에서 Shift+M → "UI 글" 탭)로 바꿔 저장하면 ui_text_layout.rpy가
## 만들어지고, 그 파일의 값이 여기 값보다 우선합니다.
################################################################################

init offset = 1

## 바꿀 글. 왼쪽 이름은 아래 목록에서 고릅니다. 줄바꿈은 \n
##
## 확인 창
##   "quit"              게임 끄기             (원래: 종료하겠습니까?)
##   "main_menu"         메인 메뉴로 가기
##   "loading"           불러오기
##   "overwrite_save"    저장 덮어쓰기
##   "delete_save"       저장 지우기
##   "end_replay"        리플레이 끝내기
##   "are_you_sure"      그 밖의 확인
##   "slow_skip"         넘기기 시작
##   "fast_skip_seen"    다음 선택지까지 넘기기
##   "fast_skip_unseen"  안 읽은 글도 넘기기
## 확인 창 버튼
##   "yes", "no"         예, 아니오
## 퀵메뉴
##   "q_back" 되감기, "q_history" 대사록, "q_skip" 넘기기, "q_auto" 자동진행, "q_save" 저장하기,
##   "q_qsave" Q.저장하기, "q_qload" Q.불러오기, "q_prefs" 설정, "q_menu" 메뉴(휴대폰 화면)
## 메인 메뉴, 게임 메뉴
##   "m_start" 시작하기, "m_load" 불러오기, "m_prefs" 환경설정, "m_main" 메인 메뉴, "m_about" 버전정보,
##   "m_help" 조작방법, "m_quit" 종료하기, "m_return" 돌아가기, "m_end_replay" 리플레이 끝내기
##
## 같은 글을 여러 곳에서 쓰면(예: "저장하기"는 퀵메뉴와 게임 메뉴) 같이 바뀝니다.
##
## 예)
##   define ui_text.texts = {
##       "quit": _("정말 게임을 끝낼까요?"),
##       "yes": _("응"),
##       "no": _("아니"),
##       "q_skip": _("빨리 넘기기"),
##   }
define ui_text.texts = { }
