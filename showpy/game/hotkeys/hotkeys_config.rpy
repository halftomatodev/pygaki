init offset = 1


## ── 새 단축키 ────────────────────────────────────────────────────────────────
## "keys": 키 이름 목록 (렌파이 키 이름: "K_v", "shift_K_s", "ctrl_K_l" ...)
## "action": 눌렀을 때 동작
##
## 예: V를 누르면 환경설정 열기
##     { "keys": [ "K_v" ], "action": ShowMenu("preferences") },

define hotkeys.bindings = [
]


## ── 렌파이 기본 단축키에서 뺄 키 ─────────────────────────────────────────────
## { "기본 단축키 이름": [ 뺄 키 ] }
## 새로 쓴 키가 기본 단축키와 겹치면 여기서 빼야 둘 다 실행되지 않아요.
##
## 예: V에 걸린 "대사 읽어주기"를 빼고 Alt+V로만
##     "self_voicing": [ "K_v" ],

define hotkeys.unbind = {
}


